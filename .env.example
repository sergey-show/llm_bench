LLM_BENCH_DATA_DIR=./data
LLM_BENCH_DEFAULT_CONCURRENCY=8
LLM_BENCH_REQUEST_TIMEOUT_S=60
LLM_BENCH_MAX_RETRIES=2
LLM_BENCH_SCORE_MIN=0
LLM_BENCH_SCORE_MAX=5

# Traffic light (100-point composite score)
# green if score_100 >= GREEN_MIN, yellow if >= YELLOW_MIN, else red
LLM_BENCH_TRAFFIC_GREEN_MIN=80
LLM_BENCH_TRAFFIC_YELLOW_MIN=60
LLM_BENCH_TRAFFIC_WEIGHT_MAE=0.50
LLM_BENCH_TRAFFIC_WEIGHT_F1=0.25
LLM_BENCH_TRAFFIC_WEIGHT_EXACT=0.15
LLM_BENCH_TRAFFIC_WEIGHT_JUDGE=0.10

# Production
LLM_BENCH_SECRET_KEY=replace-with-long-random-string
LLM_BENCH_API_TOKEN=replace-with-api-bearer-token
LLM_BENCH_API_HOST=0.0.0.0
LLM_BENCH_API_PORT=8000
LLM_BENCH_API_URL=http://127.0.0.1:8000
LLM_BENCH_MAX_PARALLEL_JOBS=2
LLM_BENCH_CORS_ORIGINS=*
LLM_BENCH_MODELS_YAML=./configs/models.yaml
LLM_BENCH_AUTO_SYNC_MODELS_YAML=true

# Provider keys referenced from configs/models.yaml
OPENROUTER_API_KEY=
